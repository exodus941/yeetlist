node_modules

# Installed by `npx skills add`. Third-party skill sources and their lock file
# belong to the machine, not to this app.
.agents
.claude/skills
skills-lock.json

# The export the app writes. It is one person's library, so it never belongs
# in the repo. Export names the file yeetlist.md, and a browser adds a counter
# when one is already there.
yeetlist.md
yeetlist*.md

.env.local
.env*.local
.vercel
.DS_Store

# The signing key and its password never reach the repository. Both live in
# %LOCALAPPDATA%\yeetlist-android, and the build in CI writes the keystore
# from a repository secret.
android/*.keystore
android/keystore-password.txt

# Gradle's own working files. Everything here is rebuilt from twa-manifest.json.
android/.gradle/
android/build/
android/app/build/
android/local.properties

# The signed output, published as a release asset rather than committed. A
# 4MB binary in the history is a 4MB binary for ever.
android/*.apk
android/*.aab
android/*.idsig
