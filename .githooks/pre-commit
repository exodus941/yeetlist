#!/bin/sh
# Let the guard PRINT. Redirecting it to /dev/null makes a failure look
# exactly like a pass, because a failing run prints nothing of its own.
set -e
node tools/syntax-guard.mjs .
node tools/version-guard.mjs
node tools/fade-guard.mjs .

node tools/listing-guard.mjs

# The notes converter and the notes/watchlist file split. Both run in plain
# Node, and the file guard evaluates app.js's own functions rather than a
# copy of them.
node tools/notes-guard.mjs
node tools/notes-file-guard.mjs

# A selection per tab, out of one set. Eleven readers share it, and any one
# of them forgetting to scope acts on rows nobody can see.
node tools/selection-guard.mjs

# Every link in an imported file has to reach a list. A video id is swept out
# of the whole text, so it survives any line shape while a page address did
# not. Both halves are asserted: the shapes arrive, and prose stays prose.
node tools/import-guard.mjs

# The share patch runs only in CI, where nothing watches it. Its clauses are
# proven here instead, so a clause that stops firing fails a commit.
node tools/android-share-fix.mjs --self-test
node tools/android-updater.mjs --self-test
