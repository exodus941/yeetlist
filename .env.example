# Copy to .env.local for the local preview, and set the same names in the
# Vercel project environment for the deployed build. Never commit .env.local.
#
# Every one is OPTIONAL. With none set the app still runs: it stores the
# watchlist in the browser, and reads a title and a channel from oEmbed.

# YouTube Data API v3. Without it the app falls back to oEmbed, which gives
# a title and a channel but no duration and no upload date.
#
# Leave this key UNRESTRICTED by HTTP referrer. It is used server-side, and a
# server sends no referrer, so a browser-restricted key is refused outright
# with "Requests from referer <empty> are blocked".
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# Google Drive sync
#
# GOOGLE_CLIENT_ID alone gives the browser-only flow. It works, and its token
# lasts about an hour with no way to renew one without a click, because the
# renewal opens a popup and browsers block a popup no click asked for.
#
# Add the other two and the server holds a refresh token instead. It then
# renews silently, so the link survives a reload, a deploy and a closed tab.
# All three are needed; with any one missing the app falls back rather than
# breaking.
# ---------------------------------------------------------------------------

# PUBLIC. It reaches the browser, and /api/config hands it over on request. It
# lives here so the repository carries no credentials, not because it is
# secret. What protects it is the Authorized JavaScript origins list in the
# Google Cloud console.
GOOGLE_CLIENT_ID=

# SECRET. This one never reaches the browser. It is used server to server, to
# trade an authorization code for a refresh token.
#
# Add BOTH of these to the OAuth client's "Authorized redirect URIs", which is
# a different list from the origins above:
#     http://localhost:3000/api/oauth/callback
#     https://YOUR-DEPLOYMENT/api/oauth/callback
GOOGLE_CLIENT_SECRET=

# SECRET. Encrypts the refresh token before it is stored in a cookie, so the
# cookie is useless to anyone who copies it. Any long random string; 32 bytes
# of real randomness is the intent:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing it logs every reader out, because the stored cookies can no longer
# be opened. That is the correct behaviour, and it is how you revoke every
# session at once.
SESSION_SECRET=
