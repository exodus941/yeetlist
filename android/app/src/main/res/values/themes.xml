<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark system chrome, no title bar, and the page colour behind
         everything, so the first frame is the same colour as the site. -->
    <style name="YeetTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:colorBackground">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
