<?xml version="1.0" encoding="utf-8"?>
<!--
    ONE WINDOW, THE LIVE SITE, NO BROWSER APP.

    The page is drawn by the web engine that ships inside Android. So the
    page's storage, its Google link cookie and its list belong to this app,
    and nothing another app does to its own data can reach them.

    The application element names "Application" on purpose.
    tools/android-updater.mjs runs in CI and swaps it for the class that checks
    for a newer build, and that patch refuses any other name. This comment
    must never spell the element's tag: the patch finds the first one in the
    file, and a tag in a comment would be patched instead.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To notice the phone coming online, so a first launch with no
         connection loads the app by itself. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name="Application"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:theme="@style/YeetTheme">

        <!-- singleTask: ONE copy of the window, always. A share arriving while
             the app is open reaches onNewIntent instead of being dropped, which
             is the fault the old wrapper needed a trampoline for.

             configChanges: turning the phone or folding it must not reload the
             page, which would throw away whatever the reader was typing. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share a link from any app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
